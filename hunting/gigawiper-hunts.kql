// Hunt 1: Microsoft-published GigaWiper infrastructure.
let PublishedInfrastructure = dynamic(["185.182.193.21", "212.8.248.104"]);
DeviceNetworkEvents
| where RemoteIP in (PublishedInfrastructure)
| project Timestamp, DeviceId, DeviceName, RemoteIP, RemotePort, Protocol, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessSHA256, ReportId

// Hunt 2: Rare executable-to-destination combinations on observed C2 ports.
let Lookback = 14d;
let Recent = 1d;
let ObservedPorts = dynamic([5544, 7542]);
// DeviceNetworkEvents frequently omits SHA256. Keep the algorithm in the key,
// prefer SHA1, and use a clearly labelled path fallback when no hash exists.
let ProcessIdentity = (sha1:string, sha256:string, folder:string, file:string) {
    case(isnotempty(sha1), strcat("sha1:", tolower(sha1)),
         isnotempty(sha256), strcat("sha256:", tolower(sha256)),
         isnotempty(folder) or isnotempty(file), strcat("path:", tolower(folder), "/", tolower(file)),
         "")
};
let Baseline = DeviceNetworkEvents
| where Timestamp between (ago(Lookback) .. ago(Recent))
| where RemotePort in (ObservedPorts)
| extend ProcessKey = ProcessIdentity(InitiatingProcessSHA1, InitiatingProcessSHA256, InitiatingProcessFolderPath, InitiatingProcessFileName)
| where isnotempty(ProcessKey)
| summarize by ProcessKey, RemoteIP, RemotePort;
DeviceNetworkEvents
| where Timestamp > ago(Recent)
| where RemotePort in (ObservedPorts)
| extend ProcessKey = ProcessIdentity(InitiatingProcessSHA1, InitiatingProcessSHA256, InitiatingProcessFolderPath, InitiatingProcessFileName)
| where isnotempty(ProcessKey)
| join kind=leftanti Baseline on ProcessKey, RemoteIP, RemotePort
| project Timestamp, DeviceId, DeviceName, RemoteIP, RemotePort, ProcessKey, InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, InitiatingProcessSHA1, InitiatingProcessSHA256, ReportId

// Hunt 3: Direct interaction with Security.evtx.
DeviceFileEvents
| where FolderPath endswith @"\Windows\System32\winevt\Logs\Security.evtx"
| where ActionType in~ ("FileDeleted", "FileRenamed", "FileModified")
| project Timestamp, DeviceId, DeviceName, ActionType, FolderPath, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessSHA256, ReportId

// Hunt 4: Firewall-rule creation masquerading as Windows Cloud Experience Host.
DeviceProcessEvents
| where FileName in~ ("powershell.exe", "pwsh.exe", "netsh.exe")
| where ProcessCommandLine has "CloudExperienceHost"
| where ProcessCommandLine has_any ("New-NetFirewallRule", "advfirewall", "-Direction Inbound", "-Direction Outbound")
| project Timestamp, DeviceId, DeviceName, FileName, FolderPath, ProcessCommandLine, AccountName, InitiatingProcessFileName, SHA256, ReportId

// Hunt 5: Screen capture or recording under an unusual ProgramData output path.
DeviceFileEvents
| where FolderPath startswith @"C:\ProgramData\output"
| where FileName endswith ".png" or FileName endswith ".mp4"
| summarize Files=count(), FirstSeen=min(Timestamp), LastSeen=max(Timestamp), SampleFiles=make_set(FileName, 20), arg_max(Timestamp, ReportId, DeviceName, InitiatingProcessFileName, InitiatingProcessCommandLine) by DeviceId
| project Timestamp, DeviceId, ReportId, DeviceName, Files, FirstSeen, LastSeen, SampleFiles, InitiatingProcessFileName, InitiatingProcessCommandLine
